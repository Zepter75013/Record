# Copier ce fichier en ".env" à côté de docker-compose.yml et renseigner
# les vraies valeurs — ce .env n'est jamais commité (voir .gitignore).

# MySQL tourne dans un conteneur Docker partagé sur le NAS (le même que
# celui utilisé par l'app Finance), accessible via son alias sur le réseau
# "disques-manager_disques-network" — ne pas définir de service MySQL dans
# ce docker-compose.yml, juste s'y connecter.
DB_HOST=bdd-mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=discdb

JWT_SECRET=

DISCOGS_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Vinyl Manager

FRONTEND_URL=
