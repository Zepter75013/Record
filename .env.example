# Copier ce fichier en ".env" à côté de docker-compose.yml (sur le NAS) et
# renseigner les vraies valeurs — ce .env n'est jamais commité (voir
# .gitignore).

# ============================================
# Configuration MySQL
# ============================================
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=discdb

# ============================================
# Configuration Backend Go
# ============================================
JWT_SECRET=
DISCOGS_TOKEN=
# Clé API RAWG.io (base de jeux vidéo), gratuite — créer un compte et une
# clé sur https://rawg.io/apidocs
RAWG_API_KEY=
# Clé API DeepL (traduction anglais -> français des descriptions/biographies
# Discogs), gratuite jusqu'à 500 000 caractères/mois — créer un compte sur
# https://www.deepl.com/fr/pro-api ("DeepL API Free")
DEEPL_API_KEY=

# ============================================
# Configuration Email (réinitialisation de mot de passe)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Disques Manager
# URL publique du frontend, utilisée pour construire le lien dans l'email de
# réinitialisation — doit être l'URL réelle d'accès à l'appli (pas
# localhost), ex: https://records-qnap.mycloudnas.com
FRONTEND_URL=

# ============================================
# Configuration Réseau
# ============================================
NAS_IP=
